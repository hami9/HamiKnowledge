# ==============================================================================
# HamiKnowledge Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
HAMIKNOWLEDGE_ENV=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hamiknowledge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Quotas (Redis)
REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL_SECONDS=3600

# Document Storage (S3-compatible / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=hamiknowledge-documents
S3_REGION=us-east-1

# AI Inference & Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
LLM_PROVIDER=offline_deterministic
LLM_MODEL=deterministic-v1

# Budget & Financial Controls
DEFAULT_WORKSPACE_BUDGET_USD=10.00
QUERY_RESERVATION_CEILING_USD=0.001
MAX_TOOL_CALLS_CEILING=3
REQUEST_DEADLINE_SECONDS=20.0

# HamiCloud Integration
HAMICLOUD_API_URL=https://api.hamicloud.local
HAMICLOUD_PROJECT_ID=project-hamiknowledge-dev
HAMICLOUD_SERVICE_TOKEN=hk-svc-placeholder-token
